# ============================================================
# PRIMEFIT COACHING — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is listed in .gitignore.
#
# These values are used when deploying to Vercel.
# Add them in: Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# Supabase project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://qhcuqyzhvuosuhtafzyu.supabase.co

# Supabase anon / public key  ← SAFE for frontend use
# Found in: Supabase Dashboard → Project Settings → API → anon public
# This key is intentionally public and is protected by Row Level Security (RLS).
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# NEVER put these in .env or anywhere in the codebase:
#
#   service_role key  — grants full DB access, bypasses RLS
#   PostgreSQL password / connection string
#
# Example of what NOT to commit:
#   postgresql://postgres:[PASSWORD]@db.qhcuqyzhvuosuhtafzyu.supabase.co:5432/postgres
# ============================================================
