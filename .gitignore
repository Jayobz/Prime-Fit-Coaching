# ============================================================
# PRIMEFIT COACHING — .gitignore
# ============================================================

# Environment variables — NEVER commit real credentials
.env
.env.local
.env.production
.env.development

# Supabase local config (generated by `supabase init`)
# Contains local project references and passwords
supabase/.temp/
supabase/config.toml

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
*.suo
*.user

# Logs
*.log
npm-debug.log*

# Node (not used here but safe to include)
node_modules/
